# NOWLII AI service (FastAPI, :8001) configuration. Copy to .env and fill in —
# .env is git-ignored and must never be committed.

# ── Auth (REQUIRED in production) ────────────────────────────────────────────
# Must be byte-identical to SECRET_KEY in nowli-backend/.env. The service verifies the
# app's Django access token with it, locally, on every /api/v1/ request.
#
# Left empty, /api/v1/ is UNAUTHENTICATED: anyone who can reach the service can call
# /realtime/token and spend your OpenAI credit. The service logs a warning on start and
# reports `auth_required: false` at /health when that is the case.
NOWLII_JWT_SECRET=
NOWLII_JWT_ALGORITHM=HS256

# ── Networking ───────────────────────────────────────────────────────────────
HOST=0.0.0.0
# Must stay 8001 — the Flutter AI_BASE_URL default, and Django owns 8000.
PORT=8001

# Comma-separated CORS origins. Only relevant to browser clients; the real client is
# the mobile app, which CORS does not apply to. Auth is what actually protects this.
AI_CORS_ORIGINS=*

# ── API keys ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Voice-prosody emotion. Without a Hume key that step is skipped, not fatal.
HUME_API_KEY=
HUME_SECRET_KEY=
HUME_CONFIG_ID=

# ── Models ───────────────────────────────────────────────────────────────────
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.7

# Pin the Realtime model — the full-size model costs several times more per call.
REALTIME_MODEL=gpt-realtime-mini
REALTIME_VOICE_MALE=cedar
REALTIME_VOICE_FEMALE=marin

# ── Backend callback ─────────────────────────────────────────────────────────
# Where quest suggestions are fetched from (the Django API).
QUEST_API_URL=http://127.0.0.1:8000/api/quests/

LOG_LEVEL=INFO
