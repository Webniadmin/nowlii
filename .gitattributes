# Shell scripts must always use LF — CRLF breaks the shebang inside Linux Docker
# containers (`exec /app/entrypoint.sh: no such file or directory`). See docs/deploy-aws.md.
*.sh text eol=lf
entrypoint.sh text eol=lf

# nginx configs get copied onto the Linux box verbatim — keep them LF for the same reason.
deploy/nginx/**/*.conf text eol=lf
