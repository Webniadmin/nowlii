# NOWLII backend configuration. Copy to .env and fill in — .env is git-ignored and
# must never be committed. Values shown are safe defaults, not real credentials.

# ── Core ─────────────────────────────────────────────────────────────────────
# REQUIRED in production. With DEBUG=False the app refuses to start on a weak key
# (shipped default, `django-insecure-` prefix, under 50 chars, or <5 distinct chars).
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Changing it invalidates every issued JWT and session — all users are logged out.
SECRET_KEY=

DEBUG=False

# Comma-separated. Every host/IP the API is reached on. Empty + DEBUG=False = 400 on
# every request.
ALLOWED_HOSTS=16.170.191.239,localhost,127.0.0.1

# ── HTTPS ────────────────────────────────────────────────────────────────────
# All OFF while production serves plain HTTP — turning any of them on without TLS in
# front locks everyone out, admin included. Flip the whole block once the API is behind
# a domain + certificate.
BEHIND_TLS_PROXY=False        # trust X-Forwarded-Proto (only when nginx/ALB sets it)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0         # ramp 3600 → 31536000 after HTTPS is confirmed working
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ── CORS / CSRF ──────────────────────────────────────────────────────────────
CORS_ALLOW_ALL_ORIGINS=False  # local development only
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=http://16.170.191.239:8000

# ── Database ─────────────────────────────────────────────────────────────────
# Omit DB_ENGINE for SQLite (local dev). Production points at RDS.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# ── Email (OTP, password reset, support) ─────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=          # Gmail app password, not the account password
DEFAULT_FROM_EMAIL=
SUPPORT_EMAIL=

# ── AI providers ─────────────────────────────────────────────────────────────
# Provider is chosen by which key is set: Anthropic → OpenAI → Google.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
AI_REQUEST_TIMEOUT=20         # seconds before Insights serves its offline fallback

# ── OAuth ────────────────────────────────────────────────────────────────────
SOCIAL_AUTH_GOOGLE_CLIENT_ID=
SOCIAL_AUTH_GOOGLE_SECRET=

# Apple Sign-In stays disabled (endpoint returns 503) until APPLE_CLIENT_IDS is set.
APPLE_CLIENT_IDS=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── AWS S3 (media) ───────────────────────────────────────────────────────────
# Media falls back to local disk when AWS_ACCESS_KEY_ID is unset.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-north-1

# ── Feature limits ───────────────────────────────────────────────────────────
VOICE_CALL_DAILY_LIMIT=2
VOICE_CALL_UNLIMITED_USERS=pavle      # QA accounts only

SUBSCRIPTION_ENFORCED=True            # False = paywall kill switch
SUBSCRIPTION_UNLIMITED_USERS=pavle    # staff/superusers are always exempt

# ── Docker entrypoint (optional superuser bootstrap) ─────────────────────────
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
